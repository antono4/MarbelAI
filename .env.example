# Konfigurasi backend Marbel AI (server.js)

# Port HTTP server
PORT=10000

# Base URL (proxy) ke 9Router — di lingkungan lokal: http://localhost:20128
# Di backend publik, TUNJUKKAN ke URL publik 9Router yang mengizinkan POST,
# contoh: https://your-9router.example.com
UPSTREAM=http://localhost:20128

# API key 9Router untuk otentikasi ke upstream /v1
API_KEY=sk-xxxxxxxxxxxx

# Origin yang diizinkan untuk CORS ('*' = semua origin, cukup untuk GitHub Pages)
ALLOW_ORIGIN=*

# Gunakan mode streaming (1=stream, 0=JSON biasa)
USE_SSE=0