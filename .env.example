# Konfigurasi backend Marbel AI (server.js)

# Port HTTP server
PORT=10000

# Base URL upstream OpenAI-compatible, gratis tanpa API key. Boleh beberapa URL
# dipisah koma — dicoba berurutan (failover). Sama dengan MarbelAIv2.1:
# uncloseai + pollinations + Free.ai.
UPSTREAM=https://hermes.ai.unturf.com,https://qwen.ai.unturf.com,https://text.pollinations.ai,https://api.free.ai

# API key upstream untuk otentikasi ke /v1 (boleh kosong bila upstream tidak butuh key)
API_KEY=

# [Opsional] Upstream cadangan Z.ai (GLM) — https://api.z.ai/api/paas/v4 (OpenAI-compatible.
# Dipakai otomatis bila upstream utama gagal/401/5xx, hanya jika ZAI_API_KEY diisi.

ZAI_UPSTREAM=https://api.z.ai/api/paas/v4
ZAI_API_KEY=

# Origin yang diizinkan untuk CORS ('*' = semua origin, cukup untuk GitHub Pages)
ALLOW_ORIGIN=*

# Gunakan mode streaming (1=stream, 0=JSON biasa)
USE_SSE=0

# ---------------------------------------------------------------------------
# DoLa — Decoding by Contrasting Layers (arXiv:2309.03883)
# ---------------------------------------------------------------------------
# Saat aktif, server mengontraskan logprobs dua model (mature vs premature)
# lalu menerapkan Adaptive Plausibility Constraint + repetition penalty.
# Butuh upstream yang mengembalikan `logprobs`; bila tidak ada, otomatis
# fallback ke dekode biasa. Bisa juga dinyalakan per-request lewat
# payload {"dola": true} dari UI (tombol DoLa).

# 1 = DoLa aktif default di server, 0 = hanya bila UI meminta.
DOLA_ENABLED=0

# Model mature (kuat/faktual) & premature (lemah/lancar) untuk kontras.
# Kosongkan agar memakai model yang diminta user.
DOLA_MATURE_MODEL=glm-4.7-flash
DOLA_PREMATURE_MODEL=qwen3-8b

# Adaptive Plausibility Constraint (paper §2.3) dan repetition penalty.
DOLA_ALPHA=0.1
DOLA_REPETITION_PENALTY=1.2

# Jumlah alternatif logprobs per token (top_logprobs).
DOLA_TOP_LOGPROBS=20